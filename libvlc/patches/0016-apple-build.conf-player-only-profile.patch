From b1c2d3e4f5a60718293a4b5c6d7e8f9012345679 Mon Sep 17 00:00:00 2001
From: YOMBI Ernest Evrard <121341980+Flamingo12345678@users.noreply.github.com>
Date: Mon, 24 Aug 2026 16:15:00 +0200
Subject: [PATCH 16/16] apple/build.conf: add player-only profile support

Supports YEEVLCKIT_PROFILE="player-only" (default) to pass --disable-sout to
contrib bootstrap (disabling BUILD_ENCODERS in FFmpeg) and configure libVLC
with --disable-sout --disable-vlm while retaining 100% of audio and video decoders.
---
 extras/package/apple/build.conf | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/extras/package/apple/build.conf b/extras/package/apple/build.conf
index 86af8564ad..97bf9564ae 100644
--- a/extras/package/apple/build.conf
+++ b/extras/package/apple/build.conf
@@ -14,6 +14,14 @@
 export VLC_DEPLOYMENT_TARGET_MACOSX="10.11"
 # iOS deployment target
 export VLC_DEPLOYMENT_TARGET_IOS="9.0"
+
+# YeeVLCKit build profile (player-only or full)
+if [ -z "${YEEVLCKIT_PROFILE}" ]; then
+    export YEEVLCKIT_PROFILE="player-only"
+fi
+
+echo "[YeeVLCKit] Configured build profile: ${YEEVLCKIT_PROFILE}"
+
 #
 # General options
 #
@@ -80,6 +88,12 @@ export VLC_CONTRIB_OPTIONS_BASE=(
     --disable-decklink
 )
 
+if [ "${YEEVLCKIT_PROFILE}" = "player-only" ]; then
+    VLC_CONTRIB_OPTIONS_BASE+=(
+        --disable-sout
+    )
+fi
+
 # Additional contrib bootstrap options for macOS
 export VLC_CONTRIB_OPTIONS_MACOSX=(
@@ -165,6 +179,14 @@ export VLC_CONFIG_OPTIONS_BASE=(
     --disable-mad
 )
 
+if [ "${YEEVLCKIT_PROFILE}" = "player-only" ]; then
+    VLC_CONFIG_OPTIONS_BASE+=(
+        --disable-sout
+        --disable-vlm
+        --disable-chromecast
+    )
+fi
+
 # Additional configure options for macOS
 export VLC_CONFIG_OPTIONS_MACOSX=()
 
-- 
